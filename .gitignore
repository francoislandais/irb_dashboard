# Fichiers de donnees utilisateur a ne jamais publier.
*.csv
*.tsv
*.xlsx
*.xls

# Fichiers systeme locaux.
.DS_Store
__pycache__/
*.pyc

# Dossiers de travail locaux.
datasets/
outputs/
work/

# Classeur versionné servant d'exemple au prototype global_update.
!outputs/
outputs/*
!outputs/global-update-prototype/
outputs/global-update-prototype/*
!outputs/global-update-prototype/global_update_examples.xlsx

# Fixture CSV contrôlée du mode de simulation global_update.
!scripts/fixtures/
!scripts/fixtures/global_update_test_data.csv

# Exceptions : mappings internes de l'application.
!app/assets/*.csv
